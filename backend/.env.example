MONGODB_URI=mongodb://localhost:27017
# Solo para scripts/init_db.py en Atlas (usuario con dbAdmin + readWrite). Vacío = usa MONGODB_URI
MONGODB_ADMIN_URI=
MONGODB_DB=utm_desk
REDIS_URL=redis://localhost:6379/0
# Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=utm-desk-evidencias
# Backblaze B2: endpoint S3 del bucket y su región (R2: dejar vacío y usar R2_ACCOUNT_ID)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
ANTHROPIC_API_KEY=
IA_HABILITADA=true
IA_MODELO=claude-opus-5-5
# Opcional: contraseña del admin sembrado por scripts/init_db.py
SEED_ADMIN_PASSWORD=
