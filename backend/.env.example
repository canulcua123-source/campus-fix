MONGODB_URI=mongodb://localhost:27017
# Solo para scripts/init_db.py en Atlas (usuario con dbAdmin + readWrite). Vacío = usa MONGODB_URI
MONGODB_ADMIN_URI=
MONGODB_DB=utm_desk
REDIS_URL=redis://localhost:6379/0
# Dominio exacto permitido para cuentas institucionales (sin @ ni protocolo)
DOMINIO_CORREO=utm.edu.mx
# Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Este archivo es para HTTP local. En producción REFRESH_COOKIE_SECURE debe ser true.
REFRESH_COOKIE_SECURE=false
# Usa lax cuando PWA y API son del mismo sitio. "none" exige Secure=true y validación de Origin.
REFRESH_COOKIE_SAMESITE=lax
LIMITE_REFRESH=10/minute
CORS_ORIGINS=http://localhost:5173
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=utm-desk-evidencias
# Backblaze B2: endpoint S3 del bucket y su región (R2: dejar vacío y usar R2_ACCOUNT_ID)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
ANTHROPIC_API_KEY=
IA_HABILITADA=true
IA_MODELO=claude-opus-5-5
# Proveedor de visión: claude | gemini (cambiarlo no requiere tocar el router)
IA_PROVEEDOR=claude
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
# gratuita | pagada. La capa gratuita usa el contenido para mejorar productos: solo para el set de evaluación.
GEMINI_CAPA=gratuita
# false (producción): bloquea Gemini en capa gratuita aunque haya clave
IA_PERMITIR_CAPA_GRATUITA=false
# Opcional. Alerta informativa si el costo estimado diario de IA supera este monto USD.
# IA_UMBRAL_COSTO_DIARIO_USD=5.00
# Opcional: contraseña del admin sembrado por scripts/init_db.py
SEED_ADMIN_PASSWORD=
